generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String       @id @default(cuid())
  name                String?
  email               String?      @unique
  emailVerified       DateTime?
  image               String?
  role                Role         @default(STUDENT)
  department          Department?
  isVerified          Boolean      @default(false)
  facebookUrl         String?
  facebookPsid        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  password            String?
  forcePasswordChange Boolean      @default(false)
  batchYear           Int?
  accounts            Account[]
  kycDocument         KycDocument?
  sessions            Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model KycDocument {
  id          String    @id @default(cuid())
  userId      String    @unique
  documentUrl String
  status      KycStatus @default(PENDING)
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id               String   @id @default(cuid())
  dailyHash        String   @unique
  teacherId        String
  rawContent       String
  moderatedText    String?
  rating           Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  studentBatchYear Int?
}

model Favorite {
  studentHash String   @id
  teacherId   String
  createdAt   DateTime @default(now())
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum Department {
  COMPUTER
  CIVIL
  ARCHITECTURE
  BASIC_SCIENCE
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}
